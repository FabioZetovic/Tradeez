{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tradeez-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .\\mvnw.cmd -q spring-boot:run"
      ],
      "port": 8081,
      "env": {
        "PORT": "8081"
      }
    },
    {
      "name": "tradeez-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173,
      "env": {
        "VITE_API_PROXY_TARGET": "http://localhost:8081"
      },
      "autoPort": true
    }
  ]
}
