# Copy to .env and fill in. Never commit .env — DEC-032: secrets never enter the repository.
# The defaults below match docker-compose.yml, so local development needs no .env at all.

DATABASE_URL=jdbc:postgresql://localhost:5432/tradeez
DATABASE_USER=tradeez
DATABASE_PASSWORD=tradeez

# Comma-separated. Explicit origins only — a wildcard is incompatible with credentialed
# requests and would defeat the cookie-based auth in DEC-032.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base64-encoded HMAC key, 256-bit minimum. Generate a fresh one per environment:
#   openssl rand -base64 32
JWT_SECRET=

PORT=8080
