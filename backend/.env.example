# Copy to .env and fill in. Never commit .env — DEC-032: secrets never enter the repository.
# The defaults below match docker-compose.yml, so local development needs no .env at all.

DATABASE_URL=jdbc:postgresql://localhost:5432/tradeez
DATABASE_USER=tradeez
DATABASE_PASSWORD=tradeez

# Comma-separated. Explicit origins only — a wildcard is incompatible with credentialed
# requests and would defeat the cookie-based auth in DEC-032.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base64-encoded HMAC key, 256-bit minimum. Generate a fresh one per environment:
#   openssl rand -base64 32
JWT_SECRET=

PORT=8080

# BUG-070 — how many proxies in front of the app append to X-Forwarded-For. 0 (the default) ignores the
# header, which a client can fill with anything; set 1 behind one proxy that appends the caller's address.
TRUSTED_PROXIES=0

# DEC-064 — check new passwords against Have I Been Pwned (k-anonymous: five hex characters of a SHA-1 hash
# leave the server, never the password). Fails open when the service does not answer.
PASSWORD_BREACH_CHECK=true

# DEC-040 — real NQ from Databento (https://databento.com). Create a key in the Databento portal and
# put it in backend/.env, never here and never in chat. Downloads are priced first and capped by
# databento.max-cost-per-request-usd and databento.max-total-cost-usd in application.yml.
DATABENTO_API_KEY=

# DEC-042 — real NQ from Massive's free plan (https://massive.com). THIS FILE IS COMMITTED: leave the
# value empty here. Put the real key in backend/.env (same folder, no ".example"), which git ignores.
# EnvExampleTest fails the build if a key value ever appears in this file (ENV-005).
MASSIVE_API_KEY=

# DEC-079 — the economic calendar's release dates from FRED (https://fred.stlouisfed.org, free key under My Account
# → API Keys). Same rule: empty here, the real key in backend/.env. Without it the News page has the FOMC only.
FRED_API_KEY=

# Throwaway account used by local browser checks (session 014). It is registered against the LOCAL
# database only and grants access to nothing but simulated practice data. Not read by the app.
# DEV_TEST_EMAIL=practice-check@tradeez.test
# DEV_TEST_PASSWORD=wPnIf6917Feumz0N
